# Canary: a mode=arc sweep under uniform placement.
# Pairs with arc-nonuniform.strok — the two should render to the same *intent*
# (an arc), and any non-uniform distortion (Cause B) shows up as a snapshot diff
# that C2's E1.5a affine fix will resolve.
documentsize 100x100

shape sweep template=path
  addpoint a at=20,70
  addpoint b at=80,70 mode=arc rx=30 ry=30 bulge=left
  fill none
  stroke #2a8c4a
  stroke-width 6

place sweep shape=sweep at=0,0 size=100x100
