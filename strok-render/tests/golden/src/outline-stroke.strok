documentsize 100x100
shape wire template=path
  stroke #1a1a1a
  stroke-width 12
  stroke-linecap round
  stroke-linejoin round
  addpoint a at=20,50
  addpoint b at=50,20 after=a
  addpoint c at=80,50 after=b
place wire shape=wire at=0,0
