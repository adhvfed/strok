---
source: strok-cli/src/mcp.rs
assertion_line: 1255
expression: catalog.to_string_pretty()
---
[
  {
    "name": "agent_intro",
    "description": "Read this first. Explains Strøk effort levels, tool discovery, construction order, visual feedback loops, and completion gates.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "name": "guide",
    "description": "Read the visual-quality workflow before authoring an illustration, icon, logo, or diagram. Covers style selection, geometry/text traps, and required review sizes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "description": "Guide topic: illustration, icon, logo, or diagram."
        }
      },
      "required": [
        "topic"
      ]
    }
  },
  {
    "name": "new",
    "description": "Create a new Strøk document. With file, writes it to disk and returns a confirmation; without, returns the DSL source. For icons, read the guide then choose an explicit visual profile.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Optional path to write the new document to (must not exist)."
        },
        "size": {
          "type": "string",
          "description": "Canvas size as WxH (default 800x800)."
        },
        "profile": {
          "type": "string",
          "description": "Optional profile: icon-outline-round, icon-outline-angular, icon-solid, or icon-mixed. `icon` is the round-outline alias."
        }
      },
      "required": []
    }
  },
  {
    "name": "read",
    "description": "Read a .strok document from disk and return its DSL source.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        }
      },
      "required": [
        "file"
      ]
    }
  },
  {
    "name": "write",
    "description": "Replace a .strok document on disk with new DSL source. The source is validated by parsing first; on error the file is left untouched and the caret diagnostics are returned. This is the general-purpose edit: read, modify the text, write.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        },
        "source": {
          "type": "string",
          "description": "The complete new document as DSL text."
        }
      },
      "required": [
        "file",
        "source"
      ]
    }
  },
  {
    "name": "exec",
    "description": "Append one or more raw DSL lines to a document. The result is validated by re-parsing before anything is written. With file, appends to the file and returns a confirmation; with source, returns the updated source.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        },
        "source": {
          "type": "string",
          "description": "The .strok document as DSL text. Pass either source or file, not both."
        },
        "line": {
          "type": "string",
          "description": "The DSL line(s) to append."
        }
      },
      "required": [
        "line"
      ]
    }
  },
  {
    "name": "render",
    "description": "Render a document to PNG, returned as an inline image. Look at it after every meaningful change. Optional width/height/color (for currentColor), bg, scheme (colorscheme for $tokens), region crop, and resolved-geometry outline inspection.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        },
        "source": {
          "type": "string",
          "description": "The .strok document as DSL text. Pass either source or file, not both."
        },
        "width": {
          "type": "integer",
          "description": "Render width in pixels."
        },
        "height": {
          "type": "integer",
          "description": "Render height in pixels."
        },
        "region": {
          "type": "string",
          "description": "Optional document-space crop as x,y,w,h for high-resolution detail review."
        },
        "outline": {
          "type": "string",
          "description": "Optional geometry overlay: '*' for all placed elements, or comma-separated placed IDs."
        },
        "color": {
          "type": "string",
          "description": "Concrete color substituted for currentColor."
        },
        "bg": {
          "type": "string",
          "description": "Background color (e.g. #ffffff)."
        },
        "scheme": {
          "type": "string",
          "description": "Colorscheme to resolve $tokens with (base palette if omitted)."
        }
      },
      "required": []
    }
  },
  {
    "name": "inspect",
    "description": "Structural snapshot of a document as JSON (detail: full|structural|summary).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        },
        "source": {
          "type": "string",
          "description": "The .strok document as DSL text. Pass either source or file, not both."
        },
        "detail": {
          "type": "string",
          "description": "full | structural | summary (default structural)."
        }
      },
      "required": []
    }
  },
  {
    "name": "query",
    "description": "Query a document by region or overlap, returned as JSON. Provide either box (x,y,w,h) or overlaps (an element id).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        },
        "source": {
          "type": "string",
          "description": "The .strok document as DSL text. Pass either source or file, not both."
        },
        "box": {
          "type": "string",
          "description": "Region as x,y,w,h."
        },
        "overlaps": {
          "type": "string",
          "description": "Element id to find overlaps of."
        }
      },
      "required": []
    }
  },
  {
    "name": "relate",
    "description": "Describe the spatial relation between two placed elements, as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        },
        "source": {
          "type": "string",
          "description": "The .strok document as DSL text. Pass either source or file, not both."
        },
        "a": {
          "type": "string",
          "description": "First element name."
        },
        "b": {
          "type": "string",
          "description": "Second element name."
        }
      },
      "required": [
        "a",
        "b"
      ]
    }
  },
  {
    "name": "measure",
    "description": "Measure distance / gap / alignment between two placed elements, as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        },
        "source": {
          "type": "string",
          "description": "The .strok document as DSL text. Pass either source or file, not both."
        },
        "a": {
          "type": "string",
          "description": "First element name."
        },
        "b": {
          "type": "string",
          "description": "Second element name."
        }
      },
      "required": [
        "a",
        "b"
      ]
    }
  },
  {
    "name": "audit",
    "description": "Run the visual-quality audit over a document and return the findings as JSON (missed abstractions, near mirrors, text collisions, rough curves). Run it after geometry changes; treat findings as evidence, not taste.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a .strok document on disk. Preferred over source: mutations write back to the file, imports resolve, and the document composes with watch and review notes."
        },
        "source": {
          "type": "string",
          "description": "The .strok document as DSL text. Pass either source or file, not both."
        }
      },
      "required": []
    }
  },
  {
    "name": "notes_list",
    "description": "List the review notes a human has pinned onto this document in a `strok watch` session (from `<file>.notes.json`). Read them first when work is handed back; they are the review feedback. Listing marks the notes as seen, so the reviewer's pins show you have them.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to the .strok document whose notes to read."
        }
      },
      "required": [
        "file"
      ]
    }
  },
  {
    "name": "note_resolve",
    "description": "Delete one pinned review note after addressing it. A running watch session reloads the sidecar, so the reviewer sees the pin clear live. Resolving the last note removes the sidecar.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to the .strok document whose note to resolve."
        },
        "id": {
          "type": "integer",
          "description": "The note id to resolve."
        }
      },
      "required": [
        "file",
        "id"
      ]
    }
  }
]
