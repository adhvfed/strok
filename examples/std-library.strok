# A curated sampler of the embedded standard shape library.
# Render: strok -f examples/std-library.strok render --out examples/std-library.png
documentsize 900x540

use "std/figures" as fig
use "std/arrows" as arr
use "std/bubbles" as bub
use "std/devices" as dev
use "std/furniture" as fur

palette
  canvas #0b1020
  card #131b2e
  border #283653
  ink #f2f5fb
  muted #8e9ab1
  lime #b9e769
  blue #6c8cff
  coral #ef7868
  wood #c6905b
  leaf #5fc18e

shape canvas template=rectangle
  fill $canvas

shape card template=rectangle
  round-corners 20
  fill $card
  stroke $border
  stroke-width 1

shape title template=text
  content "Built-in shapes"
  font-size 30
  font-weight bold
  font-family "sans-serif"
  fill $ink

shape subtitle template=text
  content "Import a module, place a shape, override its style."
  font-size 14
  font-family "sans-serif"
  fill $muted

shape people-title template=text
  content "PEOPLE"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $lime

shape comms-title template=text
  content "COMMUNICATION"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $blue

shape space-title template=text
  content "WORKSPACE"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $coral

shape note template=text
  content "std/figures"
  font-size 12
  font-family "monospace"
  fill $muted

shape comms-note template=text
  content "std/arrows + bubbles"
  font-size 12
  font-family "monospace"
  fill $muted

shape space-note template=text
  content "std/devices + furniture"
  font-size 12
  font-family "monospace"
  fill $muted

place background shape=canvas at=0,0 size=900x540
place title shape=title at=34,54
place subtitle shape=subtitle at=34,80

place people-card shape=card at=30,108 size=250x396
place comms-card shape=card at=300,108 size=270x396
place space-card shape=card at=590,108 size=280x396

place people-title shape=people-title at=52,140
place people-note shape=note at=52,164
place p1 shape=fig.person-standing at=52,198 size=46x116
  fill $lime
place p2 shape=fig.person-pointing at=116,198 size=46x116
  fill $lime
place p3 shape=fig.person-walking at=180,198 size=46x116
  fill $lime
place p4 shape=fig.person-sitting at=76,342 size=52x126
  fill $lime
place p5 shape=fig.head-side at=164,354 size=64x64
  fill $lime

place comms-title shape=comms-title at=322,140
place comms-note shape=comms-note at=322,164
place a1 shape=arr.arrow-right at=328,206 size=80x30
  fill $blue
place a2 shape=arr.arrow-curved at=442,194 size=54x54
  fill none
  stroke $blue
  stroke-width 4
place a3 shape=arr.arrow-double at=338,278 size=92x32
  fill $blue
place a4 shape=arr.chevron at=476,278 size=28x28
  fill none
  stroke $blue
  stroke-width 4
place b1 shape=bub.speech-bubble at=326,354 size=92x68
  fill $blue
place b2 shape=bub.thought-bubble at=438,350 size=94x72
  fill $blue
place b3 shape=bub.banner-ribbon at=364,448 size=118x34
  fill $coral

place space-title shape=space-title at=612,140
place space-note shape=space-note at=612,164
place d1 shape=dev.phone at=620,204 size=42x82
  fill $coral
place d2 shape=dev.laptop at=688,224 size=100x66
  fill $coral
place d3 shape=dev.browser-window at=616,326 size=106x78
  fill $coral
place d4 shape=dev.projector-screen at=742,328 size=94x74
  fill $coral
place f1 shape=fur.table at=618,438 size=94x54
  fill $wood
place f2 shape=fur.chair-side at=730,430 size=42x62
  fill $wood
place f3 shape=fur.plant at=794,428 size=42x64
  fill $leaf
