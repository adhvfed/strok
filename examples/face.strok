documentsize 800x1000

# ============================================================
# HYPERREALISTIC PORTRAIT v3 — major realism pass
# ============================================================

# --- Background ---
shape bg template=rectangle
  fill #1a1a2e
  stroke none
place bg shape=bg at=0,0 size=800x1000

# ============================================================
# SHOULDERS / SHIRT (behind everything)
# ============================================================

shape shirt template=path
  fill #2a2a3e
  stroke none
  addpoint tl at=120,870
  addpoint shoulder-l at=220,810 after=tl mode=catmull-rom tension=0.2
  addpoint collar-l at=340,790 after=shoulder-l mode=catmull-rom tension=0.2
  addpoint v at=400,840 after=collar-l mode=catmull-rom
  addpoint collar-r at=460,790 after=v mode=catmull-rom
  addpoint shoulder-r at=580,810 after=collar-r mode=catmull-rom tension=0.2
  addpoint tr at=680,870 after=shoulder-r mode=catmull-rom tension=0.2
  addpoint br at=680,1000 after=tr
  addpoint bl at=120,1000 after=br
  close
place shirt shape=shirt at=0,0

# --- Shirt shading ---
shape shirt-shadow-l template=path
  fill #1a1a2e
  stroke none
  opacity 0.3
  addpoint p1 at=120,870
  addpoint p2 at=280,820 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=300,1000 after=p2 mode=catmull-rom tension=0.4
  addpoint p4 at=120,1000 after=p3
  close
place shirt-shadow-l shape=shirt-shadow-l at=0,0

shape shirt-shadow-r template=path
  fill #1a1a2e
  stroke none
  opacity 0.3
  addpoint p1 at=680,870
  addpoint p2 at=520,820 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=500,1000 after=p2 mode=catmull-rom tension=0.4
  addpoint p4 at=680,1000 after=p3
  close
place shirt-shadow-r shape=shirt-shadow-r at=0,0

shape shirt-fold template=path
  stroke #222238
  stroke-width 1.5
  fill none
  opacity 0.4
  addpoint p1 at=400,840
  addpoint p2 at=395,900 after=p1 mode=catmull-rom tension=0.4
  addpoint p3 at=390,960 after=p2 mode=catmull-rom tension=0.4
place shirt-fold shape=shirt-fold at=0,0

# ============================================================
# HAIR BACK MASS (behind face and ears)
# ============================================================

shape hair-back template=path
  fill #120a06
  stroke none
  addpoint bl at=210,370
  addpoint tl at=218,240 after=bl mode=catmull-rom
  addpoint top-l at=280,170 after=tl mode=catmull-rom
  addpoint crown at=400,148 after=top-l mode=catmull-rom
  addpoint top-r at=520,170 after=crown mode=catmull-rom
  addpoint tr at=582,240 after=top-r mode=catmull-rom
  addpoint br at=595,370 after=tr mode=catmull-rom
  addpoint side-r at=588,430 after=br mode=catmull-rom tension=0.4
  addpoint ear-r at=582,475 after=side-r mode=catmull-rom tension=0.4
  addpoint low-r at=570,420 after=ear-r mode=catmull-rom tension=0.4
  addpoint temp-r at=558,340 after=low-r mode=catmull-rom tension=0.4
  addpoint fh-r at=530,305 after=temp-r mode=catmull-rom tension=0.2
  addpoint fh-mr at=468,292 after=fh-r mode=catmull-rom
  addpoint fh-m at=400,288 after=fh-mr mode=catmull-rom
  addpoint fh-ml at=332,292 after=fh-m mode=catmull-rom
  addpoint fh-l at=270,305 after=fh-ml mode=catmull-rom tension=0.2
  addpoint temp-l at=242,340 after=fh-l mode=catmull-rom tension=0.4
  addpoint low-l at=230,420 after=temp-l mode=catmull-rom tension=0.4
  addpoint ear-l at=218,475 after=low-l mode=catmull-rom tension=0.4
  addpoint side-l at=212,430 after=ear-l mode=catmull-rom tension=0.4
  close
place hair-back shape=hair-back at=0,0

# ============================================================
# NECK
# ============================================================

shape neck template=path
  fill #c89a68
  stroke none
  addpoint tl at=335,680
  addpoint tr at=465,680
  addpoint tr2 at=475,730 after=tr mode=catmull-rom tension=0.2
  addpoint br at=500,900 after=tr2 mode=catmull-rom tension=0.4
  addpoint bl at=300,900 after=br mode=catmull-rom tension=0.4
  addpoint tl2 at=325,730 after=bl mode=catmull-rom tension=0.2
  close
place neck shape=neck at=0,0

# --- Neck center highlight ---
shape neck-hi template=ellipse
  fill #d8b080
  stroke none
  opacity 0.15
place neck-hi shape=neck-hi at=370,730 size=70x120

# --- Neck side shadows ---
shape neck-shd-l template=path
  fill #8a5c30
  stroke none
  opacity 0.25
  addpoint p1 at=325,700
  addpoint p2 at=360,700 after=p1 mode=catmull-rom tension=0.4
  addpoint p3 at=348,860 after=p2 mode=catmull-rom tension=0.4
  addpoint p4 at=305,860 after=p3 mode=catmull-rom tension=0.4
  close
place neck-shd-l shape=neck-shd-l at=0,0

shape neck-shd-r template=path
  fill #8a5c30
  stroke none
  opacity 0.25
  addpoint p1 at=475,700
  addpoint p2 at=440,700 after=p1 mode=catmull-rom tension=0.4
  addpoint p3 at=452,860 after=p2 mode=catmull-rom tension=0.4
  addpoint p4 at=495,860 after=p3 mode=catmull-rom tension=0.4
  close
place neck-shd-r shape=neck-shd-r at=0,0

# --- Neck tendons (sternocleidomastoid hints) ---
shape tendon-l template=path
  stroke #b08050
  stroke-width 1
  fill none
  opacity 0.12
  addpoint top at=365,695
  addpoint bot at=330,820 after=top mode=catmull-rom tension=0.2
place tendon-l shape=tendon-l at=0,0

shape tendon-r template=path
  stroke #b08050
  stroke-width 1
  fill none
  opacity 0.12
  addpoint top at=435,695
  addpoint bot at=470,820 after=top mode=catmull-rom tension=0.2
place tendon-r shape=tendon-r at=0,0

# --- Under-jaw shadow (bridges face to neck) ---
shape jaw-under template=path
  fill #7a4c28
  stroke none
  opacity 0.35
  addpoint l at=300,680
  addpoint ml at=355,695 after=l mode=catmull-rom tension=0.2
  addpoint m at=400,700 after=ml mode=catmull-rom
  addpoint mr at=445,695 after=m mode=catmull-rom tension=0.2
  addpoint r at=500,680 after=mr mode=catmull-rom tension=0.2
  addpoint rb at=478,712 after=r mode=catmull-rom tension=0.4
  addpoint mb at=400,720 after=rb mode=catmull-rom
  addpoint lb at=322,712 after=mb mode=catmull-rom tension=0.4
  close
place jaw-under shape=jaw-under at=0,0

# --- Collarbone hints ---
shape collarbone-l template=path
  stroke #a07848
  stroke-width 1
  fill none
  opacity 0.15
  addpoint p1 at=310,810
  addpoint p2 at=370,820 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=400,830 after=p2 mode=catmull-rom tension=0.4
place collarbone-l shape=collarbone-l at=0,0

shape collarbone-r template=path
  stroke #a07848
  stroke-width 1
  fill none
  opacity 0.15
  addpoint p1 at=490,810
  addpoint p2 at=430,820 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=400,830 after=p2 mode=catmull-rom tension=0.4
place collarbone-r shape=collarbone-r at=0,0

# ============================================================
# EARS (partially behind face)
# ============================================================

shape ear-l template=path
  fill #c89a68
  stroke #b08050
  stroke-width 1
  addpoint top at=228,400
  addpoint outer-t at=208,430 after=top mode=catmull-rom
  addpoint outer at=200,470 after=outer-t mode=catmull-rom
  addpoint lobe at=215,520 after=outer mode=catmull-rom
  addpoint inner-b at=238,505 after=lobe mode=catmull-rom tension=0.2
  addpoint inner at=235,460 after=inner-b mode=catmull-rom tension=0.2
  addpoint inner-t at=232,420 after=inner mode=catmull-rom tension=0.2
  close
place ear-l shape=ear-l at=0,0

shape ear-r template=path
  fill #c89a68
  stroke #b08050
  stroke-width 1
  addpoint top at=572,400
  addpoint outer-t at=592,430 after=top mode=catmull-rom
  addpoint outer at=600,470 after=outer-t mode=catmull-rom
  addpoint lobe at=585,520 after=outer mode=catmull-rom
  addpoint inner-b at=562,505 after=lobe mode=catmull-rom tension=0.2
  addpoint inner at=565,460 after=inner-b mode=catmull-rom tension=0.2
  addpoint inner-t at=568,420 after=inner mode=catmull-rom tension=0.2
  close
place ear-r shape=ear-r at=0,0

# --- Ear inner cartilage ---
shape ear-cart-l template=path
  fill #a07848
  stroke none
  opacity 0.35
  addpoint top at=230,415
  addpoint outer at=212,450 after=top mode=catmull-rom
  addpoint bot at=220,495 after=outer mode=catmull-rom
  addpoint inner at=235,470 after=bot mode=catmull-rom tension=0.2
  addpoint mid at=228,440 after=inner mode=catmull-rom tension=0.2
  close
place ear-cart-l shape=ear-cart-l at=0,0

shape ear-cart-r template=path
  fill #a07848
  stroke none
  opacity 0.35
  addpoint top at=570,415
  addpoint outer at=588,450 after=top mode=catmull-rom
  addpoint bot at=580,495 after=outer mode=catmull-rom
  addpoint inner at=565,470 after=bot mode=catmull-rom tension=0.2
  addpoint mid at=572,440 after=inner mode=catmull-rom tension=0.2
  close
place ear-cart-r shape=ear-cart-r at=0,0

# --- Ear warm translucency (SSS) ---
shape ear-sss-l template=ellipse
  fill #d07040
  stroke none
  opacity 0.12
place ear-sss-l shape=ear-sss-l at=205,455 size=30x50

shape ear-sss-r template=ellipse
  fill #d07040
  stroke none
  opacity 0.12
place ear-sss-r shape=ear-sss-r at=578,455 size=30x50

# ============================================================
# FACE OVAL — wider jaw, less pointy chin
# ============================================================

shape face template=path
  fill #c89a68
  stroke none
  addpoint forehead-l at=255,315
  addpoint forehead-r at=545,315 after=forehead-l mode=catmull-rom
  addpoint temple-r at=575,390 after=forehead-r mode=catmull-rom
  addpoint cheekbone-r at=575,470 after=temple-r mode=catmull-rom tension=0.2
  addpoint cheek-r at=565,540 after=cheekbone-r mode=catmull-rom tension=0.2
  addpoint jaw-r at=540,610 after=cheek-r mode=catmull-rom tension=0.2
  addpoint jaw-corner-r at=490,660 after=jaw-r mode=catmull-rom
  addpoint chin-r at=440,680 after=jaw-corner-r mode=catmull-rom
  addpoint chin at=400,688 after=chin-r mode=catmull-rom
  addpoint chin-l at=360,680 after=chin mode=catmull-rom
  addpoint jaw-corner-l at=310,660 after=chin-l mode=catmull-rom
  addpoint jaw-l at=260,610 after=jaw-corner-l mode=catmull-rom tension=0.2
  addpoint cheek-l at=235,540 after=jaw-l mode=catmull-rom tension=0.2
  addpoint cheekbone-l at=225,470 after=cheek-l mode=catmull-rom tension=0.2
  addpoint temple-l at=225,390 after=cheekbone-l mode=catmull-rom
  close
place face shape=face at=0,0

# ============================================================
# SKIN SHADING — many small overlapping shapes for smooth blending
# ============================================================

# --- Forehead zone (broad warm highlight) ---
shape fh-hi-1 template=ellipse
  fill #d8b080
  stroke none
  opacity 0.1
place fh-hi-1 shape=fh-hi-1 at=310,310 size=180x80

shape fh-hi-2 template=ellipse
  fill #d4aa78
  stroke none
  opacity 0.08
place fh-hi-2 shape=fh-hi-2 at=340,330 size=130x60

shape fh-hi-3 template=ellipse
  fill #e0c090
  stroke none
  opacity 0.06
place fh-hi-3 shape=fh-hi-3 at=360,320 size=90x50

# --- T-zone (forehead through nose bridge) ---
shape tzone-1 template=path
  fill #d8b480
  stroke none
  opacity 0.08
  addpoint top at=400,305
  addpoint top-w at=440,350 after=top mode=catmull-rom
  addpoint mid at=420,440 after=top-w mode=catmull-rom tension=0.2
  addpoint nose at=412,540 after=mid mode=catmull-rom tension=0.4
  addpoint nose-b at=388,540 after=nose mode=catmull-rom tension=0.4
  addpoint mid-l at=380,440 after=nose-b mode=catmull-rom tension=0.2
  addpoint top-wl at=360,350 after=mid-l mode=catmull-rom
  close
place tzone-1 shape=tzone-1 at=0,0

shape tzone-2 template=path
  fill #debb88
  stroke none
  opacity 0.06
  addpoint top at=400,310
  addpoint r at=425,370 after=top mode=catmull-rom
  addpoint bot at=410,480 after=r mode=catmull-rom tension=0.4
  addpoint bot2 at=390,480 after=bot mode=catmull-rom tension=0.4
  addpoint l at=375,370 after=bot2 mode=catmull-rom
  close
place tzone-2 shape=tzone-2 at=0,0

# --- Temple shadows (sculpt face width) ---
shape temple-shd-l-1 template=ellipse
  fill #9a6840
  stroke none
  opacity 0.1
place temple-shd-l-1 shape=temple-shd-l-1 at=225,370 size=70x100

shape temple-shd-l-2 template=ellipse
  fill #8a5c38
  stroke none
  opacity 0.07
place temple-shd-l-2 shape=temple-shd-l-2 at=230,390 size=55x80

shape temple-shd-r-1 template=ellipse
  fill #9a6840
  stroke none
  opacity 0.1
place temple-shd-r-1 shape=temple-shd-r-1 at=510,370 size=70x100

shape temple-shd-r-2 template=ellipse
  fill #8a5c38
  stroke none
  opacity 0.07
place temple-shd-r-2 shape=temple-shd-r-2 at=518,390 size=55x80

# --- Cheekbone highlights (subtle, layered) ---
shape chk-hi-l-1 template=ellipse
  fill #d8b480
  stroke none
  opacity 0.08
place chk-hi-l-1 shape=chk-hi-l-1 at=248,470 size=100x70

shape chk-hi-l-2 template=ellipse
  fill #debb88
  stroke none
  opacity 0.06
place chk-hi-l-2 shape=chk-hi-l-2 at=255,478 size=80x55

shape chk-hi-l-3 template=ellipse
  fill #e0c090
  stroke none
  opacity 0.05
place chk-hi-l-3 shape=chk-hi-l-3 at=262,482 size=60x40

shape chk-hi-r-1 template=ellipse
  fill #d8b480
  stroke none
  opacity 0.08
place chk-hi-r-1 shape=chk-hi-r-1 at=462,470 size=100x70

shape chk-hi-r-2 template=ellipse
  fill #debb88
  stroke none
  opacity 0.06
place chk-hi-r-2 shape=chk-hi-r-2 at=470,478 size=80x55

shape chk-hi-r-3 template=ellipse
  fill #e0c090
  stroke none
  opacity 0.05
place chk-hi-r-3 shape=chk-hi-r-3 at=478,482 size=60x40

# --- Cheek warmth (rosy, very subtle SSS) ---
shape chk-warm-l-1 template=ellipse
  fill #c06848
  stroke none
  opacity 0.06
place chk-warm-l-1 shape=chk-warm-l-1 at=258,500 size=100x70

shape chk-warm-l-2 template=ellipse
  fill #c07050
  stroke none
  opacity 0.05
place chk-warm-l-2 shape=chk-warm-l-2 at=268,510 size=75x50

shape chk-warm-r-1 template=ellipse
  fill #c06848
  stroke none
  opacity 0.06
place chk-warm-r-1 shape=chk-warm-r-1 at=450,500 size=100x70

shape chk-warm-r-2 template=ellipse
  fill #c07050
  stroke none
  opacity 0.05
place chk-warm-r-2 shape=chk-warm-r-2 at=460,510 size=75x50

# --- Lower cheek / jaw shadow ---
shape jaw-shd-l-1 template=path
  fill #9a6838
  stroke none
  opacity 0.08
  addpoint p1 at=235,540
  addpoint p2 at=270,620 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=330,665 after=p2 mode=catmull-rom tension=0.2
  addpoint p4 at=290,600 after=p3 mode=catmull-rom tension=0.4
  addpoint p5 at=240,530 after=p4 mode=catmull-rom tension=0.4
  close
place jaw-shd-l-1 shape=jaw-shd-l-1 at=0,0

shape jaw-shd-l-2 template=path
  fill #8a5c30
  stroke none
  opacity 0.06
  addpoint p1 at=242,555
  addpoint p2 at=275,630 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=320,660 after=p2 mode=catmull-rom tension=0.2
  addpoint p4 at=285,615 after=p3 mode=catmull-rom tension=0.4
  addpoint p5 at=248,548 after=p4 mode=catmull-rom tension=0.4
  close
place jaw-shd-l-2 shape=jaw-shd-l-2 at=0,0

shape jaw-shd-r-1 template=path
  fill #9a6838
  stroke none
  opacity 0.08
  addpoint p1 at=565,540
  addpoint p2 at=530,620 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=470,665 after=p2 mode=catmull-rom tension=0.2
  addpoint p4 at=510,600 after=p3 mode=catmull-rom tension=0.4
  addpoint p5 at=560,530 after=p4 mode=catmull-rom tension=0.4
  close
place jaw-shd-r-1 shape=jaw-shd-r-1 at=0,0

shape jaw-shd-r-2 template=path
  fill #8a5c30
  stroke none
  opacity 0.06
  addpoint p1 at=558,555
  addpoint p2 at=525,630 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=480,660 after=p2 mode=catmull-rom tension=0.2
  addpoint p4 at=515,615 after=p3 mode=catmull-rom tension=0.4
  addpoint p5 at=552,548 after=p4 mode=catmull-rom tension=0.4
  close
place jaw-shd-r-2 shape=jaw-shd-r-2 at=0,0

# --- Chin highlight ---
shape chin-hi-1 template=ellipse
  fill #d4aa78
  stroke none
  opacity 0.08
place chin-hi-1 shape=chin-hi-1 at=375,660 size=60x28

shape chin-hi-2 template=ellipse
  fill #debb88
  stroke none
  opacity 0.06
place chin-hi-2 shape=chin-hi-2 at=380,662 size=45x20

# --- Under-eye area (subtle warm shadow) ---
shape undereye-warm-l template=ellipse
  fill #a07858
  stroke none
  opacity 0.06
place undereye-warm-l shape=undereye-warm-l at=270,462 size=80x22

shape undereye-warm-r template=ellipse
  fill #a07858
  stroke none
  opacity 0.06
place undereye-warm-r shape=undereye-warm-r at=450,462 size=80x22

# --- Nose side shadows ---
shape nose-side-l template=path
  fill #a07040
  stroke none
  opacity 0.1
  addpoint top at=370,445
  addpoint mid at=362,510 after=top mode=catmull-rom tension=0.2
  addpoint bot at=358,558 after=mid mode=catmull-rom tension=0.4
  addpoint inner at=382,540 after=bot mode=catmull-rom tension=0.4
  addpoint itop at=378,460 after=inner mode=catmull-rom tension=0.2
  close
place nose-side-l shape=nose-side-l at=0,0

shape nose-side-r template=path
  fill #a07040
  stroke none
  opacity 0.1
  addpoint top at=430,445
  addpoint mid at=438,510 after=top mode=catmull-rom tension=0.2
  addpoint bot at=442,558 after=mid mode=catmull-rom tension=0.4
  addpoint inner at=418,540 after=bot mode=catmull-rom tension=0.4
  addpoint itop at=422,460 after=inner mode=catmull-rom tension=0.2
  close
place nose-side-r shape=nose-side-r at=0,0

# --- Nose side shadow layer 2 (tighter) ---
shape nose-side-l2 template=path
  fill #8a5c30
  stroke none
  opacity 0.07
  addpoint top at=374,460
  addpoint mid at=368,520 after=top mode=catmull-rom tension=0.2
  addpoint bot at=364,555 after=mid mode=catmull-rom tension=0.4
  addpoint inner at=385,535 after=bot mode=catmull-rom tension=0.4
  addpoint itop at=380,470 after=inner mode=catmull-rom tension=0.2
  close
place nose-side-l2 shape=nose-side-l2 at=0,0

shape nose-side-r2 template=path
  fill #8a5c30
  stroke none
  opacity 0.07
  addpoint top at=426,460
  addpoint mid at=432,520 after=top mode=catmull-rom tension=0.2
  addpoint bot at=436,555 after=mid mode=catmull-rom tension=0.4
  addpoint inner at=415,535 after=bot mode=catmull-rom tension=0.4
  addpoint itop at=420,470 after=inner mode=catmull-rom tension=0.2
  close
place nose-side-r2 shape=nose-side-r2 at=0,0

# ============================================================
# EYES — larger, more detailed
# ============================================================

# --- Eye socket shadows (broad, soft) ---
shape eye-socket template=ellipse
  fill #9a6848
  stroke none
  opacity 0.1
place eye-socket-l shape=eye-socket at=240,425 size=160x70
place eye-socket-r shape=eye-socket at=430,425 size=160x70

shape eye-socket-2 template=ellipse
  fill #8a5c40
  stroke none
  opacity 0.07
place eye-socket-2l shape=eye-socket-2 at=252,430 size=130x58
place eye-socket-2r shape=eye-socket-2 at=442,430 size=130x58

# --- Eye whites (large almond) ---
shape eye-white-l template=path
  fill #eee8e0
  stroke none
  addpoint inner at=265,445
  addpoint top-i at=288,428 after=inner mode=catmull-rom
  addpoint top at=318,420 after=top-i mode=catmull-rom
  addpoint top-o at=348,428 after=top mode=catmull-rom
  addpoint outer at=375,442 after=top-o mode=catmull-rom tension=0.2
  addpoint bot-o at=350,460 after=outer mode=catmull-rom tension=0.2
  addpoint bottom at=318,467 after=bot-o mode=catmull-rom
  addpoint bot-i at=288,460 after=bottom mode=catmull-rom tension=0.2
  close
place eye-white-l shape=eye-white-l at=0,0

shape eye-white-r template=path
  fill #eee8e0
  stroke none
  addpoint inner at=535,445
  addpoint top-o at=512,428 after=inner mode=catmull-rom
  addpoint top at=482,420 after=top-o mode=catmull-rom
  addpoint top-i at=452,428 after=top mode=catmull-rom
  addpoint outer at=425,442 after=top-i mode=catmull-rom tension=0.2
  addpoint bot-i at=450,460 after=outer mode=catmull-rom tension=0.2
  addpoint bottom at=482,467 after=bot-i mode=catmull-rom
  addpoint bot-o at=512,460 after=bottom mode=catmull-rom tension=0.2
  close
place eye-white-r shape=eye-white-r at=0,0

# --- Eye white shadow (veins hint) ---
shape eye-vein-l template=ellipse
  fill #d8b0a0
  stroke none
