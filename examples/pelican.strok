documentsize 800x600

shape sky template=rectangle
  fill #c8e4f8
  stroke none
place sky shape=sky at=0,0 size=800x600

shape ground template=rectangle
  fill #8cb860
  stroke none
place ground shape=ground at=0,520 size=800x80

shape road template=rectangle
  fill #888888
  stroke none
place road shape=road at=0,530 size=800x20

