place gt6 shape=grass-tuft at=750,518 size=13x12

shape cloud template=path
  fill #ffffff
  stroke none
  opacity 0.8
  addpoint p1 at=0,30
  addpoint p2 at=10,15 after=p1 mode=catmull-rom tension=0.2
  addpoint p3 at=30,5 after=p2 mode=catmull-rom tension=0.2
  addpoint p4 at=55,0 after=p3 mode=catmull-rom tension=0.2
  addpoint p5 at=80,8 after=p4 mode=catmull-rom tension=0.2
  addpoint p6 at=100,3 after=p5 mode=catmull-rom tension=0.2
  addpoint p7 at=120,12 after=p6 mode=catmull-rom tension=0.2
  addpoint p8 at=130,30 after=p7 mode=catmull-rom tension=0.2
  close
place cloud1 shape=cloud at=50,30 size=140x40
place cloud2 shape=cloud at=550,15 size=180x45
place cloud3 shape=cloud at=300,50 size=100x30

