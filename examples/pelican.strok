shape grass-tuft template=path
  fill #6da040
  stroke none
  addpoint p1 at=0,10
  addpoint p2 at=3,0 after=p1 mode=catmull-rom tension=0.4
  addpoint p3 at=6,10 after=p2 mode=catmull-rom tension=0.4
  addpoint p4 at=9,2 after=p3 mode=catmull-rom tension=0.4
  addpoint p5 at=12,10 after=p4 mode=catmull-rom tension=0.4
  close
