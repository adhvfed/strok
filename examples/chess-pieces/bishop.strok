# @meaning Bishop chess piece
# @tags chess, piece, bishop, mitre, staunton, game
documentsize 45x45

palette
  piece-fill #f7f3ea
  piece-shade #cfc0a3
  piece-detail #3a352e
scheme white
  piece-fill #f7f3ea
  piece-shade #cfc0a3
  piece-detail #3a352e
scheme black
  piece-fill #302b26
  piece-shade #17130f
  piece-detail #0d0b09

defaults
  fill $piece-fill
  stroke none

# The head is a simple pear-shaped mitre. The sparse contour avoids the paired
# shoulder anchors that produced visible bumps in the previous version.
shape mitre template=path
  addpoint top-left at=21.2,8.1
  addpoint left-bowl at=16.2,18.3 after=top-left mode=controls c1=18.4,10.4 c2=16.1,14.8
  addpoint bottom at=22.5,25.2 after=left-bowl mode=controls c1=16.3,22.3 c2=19.3,24.9
  addpoint right-bowl at=28.8,18.3 after=bottom mode=controls c1=25.7,24.9 c2=28.7,22.3
  addpoint top-right at=23.8,8.1 after=right-bowl mode=controls c1=28.9,14.8 c2=26.6,10.4
  addpoint top-return at=21.2,8.1 after=top-right
  close

# A subtractive wedge enters through the edge of the mitre. This keeps the
# traditional bishop incision transparent and independently refinable.
shape mitre-incision template=path
  addpoint outer-upper at=29.4,14.05
  addpoint tip at=23.15,17.7 after=outer-upper mode=controls c1=27.25,15.0 c2=24.55,17.2
  addpoint outer-lower at=29.45,16.2 after=tip mode=controls c1=24.45,18.05 c2=27.55,16.95
  close

shape orb template=ellipse

shape stem template=path
  addpoint top-left at=18.9,26.7
  addpoint top-right at=26.1,26.7 after=top-left
  addpoint waist-right at=25.7,30.1 after=top-right mode=controls c1=26.1,28 c2=25.6,29.1
  addpoint foot-right at=30.2,33.8 after=waist-right mode=controls c1=26.6,31.4 c2=28.9,33.1
  addpoint foot-left at=14.8,33.8 after=foot-right
  addpoint waist-left at=19.3,30.1 after=foot-left mode=controls c1=16.1,33.1 c2=18.4,31.4
  addpoint top-return at=18.9,26.7 after=waist-left mode=controls c1=19.4,29.1 c2=18.9,28
  close

shape ring template=rectangle
  round-corners 0.65

shape foot template=path
  addpoint top-left at=13.4,34
  addpoint top-right at=31.6,34 after=top-left
  addpoint bottom-right at=33.6,36.7 after=top-right
  addpoint bottom-left at=11.4,36.7 after=bottom-right
  close

shape plinth template=rectangle
  round-corners 0.75

# Keep the cut and orb as named geometry in the editor. Strøk does not yet
# nest live booleans, so the identically filled overlap reads as one silhouette.
boolean mitre-silhouette op=subtract
  place mitre-body shape=mitre at=0,0
  place incision shape=mitre-incision at=0,0
  fill $piece-fill
  stroke none

place orb shape=orb at=20.35,3.9 size=4.3x4.3

boolean bishop-body op=union
  place crown-ring shape=ring at=16.8,24.5 size=11.4x3.5
  place stem shape=stem at=0,0
  place body-ring shape=ring at=13.5,32.5 size=18x3.4
  place foot shape=foot at=0,0
  place plinth shape=plinth at=9.9,36.2 size=25.2x4.2
  fill $piece-fill
  stroke none

shape shadow-band template=rectangle
  fill $piece-shade

place crown-shadow shape=shadow-band at=17,26.95 size=11x0.65 clip=bishop-body
place body-shadow shape=shadow-band at=13.7,34.75 size=17.6x0.65 clip=bishop-body
place plinth-shadow shape=shadow-band at=10.5,38.85 size=24x0.8 clip=bishop-body
