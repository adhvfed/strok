# @meaning King chess piece
# @tags chess, piece, king, cross, crown, staunton, game
documentsize 45x45

palette
  piece-fill #f7f3ea
  piece-shade #cfc0a3
  piece-detail #3a352e
scheme white
  piece-fill #f7f3ea
  piece-shade #cfc0a3
  piece-detail #3a352e
scheme black
  piece-fill #302b26
  piece-shade #17130f
  piece-detail #0d0b09

defaults
  fill $piece-fill
  stroke none

# The cross is built from two softly squared bars. Their proportions stay clear
# at board size, while each bar remains independently adjustable in Strøk.
shape cross-bar template=rectangle
  round-corners 0.25

# A flat top and broad shoulders replace the former egg-shaped cap. The cap is
# still turned and soft, but reads as a royal crown beneath the cross.
shape crown template=path
  addpoint top-left at=20.45,10.4
  addpoint left-shoulder at=16.7,16.0 after=top-left mode=controls c1=18.2,11.4 c2=16.7,13.6
  addpoint left-base at=18.0,21.25 after=left-shoulder mode=controls c1=16.7,18.3 c2=17.3,20.2
  addpoint right-base at=27.0,21.25 after=left-base
  addpoint right-shoulder at=28.3,16.0 after=right-base mode=controls c1=27.7,20.2 c2=28.3,18.3
  addpoint top-right at=24.55,10.4 after=right-shoulder mode=controls c1=28.3,13.6 c2=26.8,11.4
  addpoint top-return at=20.45,10.4 after=top-right
  close

shape stem template=path
  addpoint top-left at=17.8,23
  addpoint top-right at=27.2,23 after=top-left
  addpoint waist-right at=26.1,29 after=top-right mode=controls c1=27.2,25.3 c2=26.1,27.2
  addpoint foot-right at=31.2,33.8 after=waist-right mode=controls c1=26.1,31 c2=29.7,33
  addpoint foot-left at=13.8,33.8 after=foot-right
  addpoint waist-left at=18.9,29 after=foot-left mode=controls c1=15.3,33 c2=18.9,31
  addpoint top-return at=17.8,23 after=waist-left mode=controls c1=18.9,27.2 c2=17.8,25.3
  close

shape ring template=rectangle
  round-corners 0.65

# As on the queen, the lower collar is rounded only where exposed. Its square
# underside meets the flared foot without a pinched boolean seam.
shape body-ring template=rectangle
  round-corners tl=0.65 tr=0.65 br=0 bl=0

shape foot template=path
  addpoint top-left at=12.7,35.8
  addpoint top-right at=32.3,35.8 after=top-left
  addpoint bottom-right at=34.8,36.8 after=top-right
  addpoint bottom-left at=10.2,36.8 after=bottom-right
  close

shape plinth template=rectangle
  round-corners 0.75

boolean king-silhouette op=union
  place cross-vertical shape=cross-bar at=21.2,1.8 size=2.6x9.6
  place cross-horizontal shape=cross-bar at=18.45,5.0 size=8.1x2.8
  place crown shape=crown at=0,0
  place crown-ring shape=ring at=15.0,20.45 size=15x3.7
  place stem shape=stem at=0,0
  place body-ring shape=body-ring at=12.7,32.5 size=19.6x3.5
  place foot shape=foot at=0,0
  place plinth shape=plinth at=8.6,36.2 size=27.8x4.2
  fill $piece-fill
  stroke none

shape shadow-band template=rectangle
  fill $piece-shade

place crown-shadow shape=shadow-band at=15.2,23.05 size=14.6x0.65 clip=king-silhouette
place body-shadow shape=shadow-band at=12.9,34.75 size=19.2x0.65 clip=king-silhouette
place plinth-shadow shape=shadow-band at=9.2,38.85 size=26.6x0.8 clip=king-silhouette
