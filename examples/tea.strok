# Quiet Hour — a showcase editorial illustration.
#
# Agent effort: showcase. Review the full frame and the two focal regions:
#   strok -f examples/tea.strok render --out examples/tea.png
#   strok -f examples/tea.strok render --region 120,430,500,250 --width 1400 --out /tmp/tea-book.png
#   strok -f examples/tea.strok render --region 600,400,300,260 --width 1200 --out /tmp/tea-cup.png
#   strok -f examples/tea.strok render --outline cup-body,cup-rim,handle,tea --region 590,450,240,190 --width 1400 --out /tmp/tea-cup-geometry.png
documentsize 960x720

palette
  night #071521
  night-mid #0d2638
  night-soft #17394d
  window-frame #203d50
  moon #ffd58a
  moon-edge #f2ad58
  desk #3a251f
  desk-light #603c2d
  desk-edge #241713
  ceramic #f6efe4
  ceramic-warm #ddd0bf
  tea #a95829
  tea-light #d58445
  paper #eee0c5
  paper-light #f7ecd7
  paper-edge #bfa783
  ink #f5ead8
  muted #9fb2c1
  type #7e6c55
  metal #b8c6ce
  metal-dark #6d818e
  accent #58b89a

# --- Atmosphere -------------------------------------------------------------

shape background template=rectangle
  fill linear(top, bottom, #071521, #17394d)

shape window-recess template=rectangle
  round-corners 18
  fill #06111b
  stroke $window-frame
  stroke-width 8

shape sky-glow template=ellipse
  fill radial(center, 74%, #f2ad58, transparent)
  opacity 0.28
  blur 28

shape moon template=ellipse
  fill radial(center, 78%, #ffd58a, #f2ad58)

shape moon-shade template=ellipse
  fill #e8a74f
  opacity 0.16

shape star template=ellipse
  fill #dce9ef
  opacity 0.72

shape far-hills template=path
  addpoint left at=70,360
  addpoint a at=170,294 mode=catmull-rom tension=0.18
  addpoint b at=280,334 mode=catmull-rom tension=0.18
  addpoint c at=408,250 mode=catmull-rom tension=0.18
  addpoint d at=528,312 mode=catmull-rom tension=0.18
  addpoint e at=652,236 mode=catmull-rom tension=0.18
  addpoint f at=784,310 mode=catmull-rom tension=0.18
  addpoint right at=890,270 mode=catmull-rom tension=0.18
  addpoint br at=890,416
  addpoint bl at=70,416
  close
  fill #10293a

shape near-hills template=path
  addpoint left at=70,380
  addpoint a at=210,326 mode=catmull-rom tension=0.16
  addpoint b at=350,382 mode=catmull-rom tension=0.16
  addpoint c at=520,306 mode=catmull-rom tension=0.16
  addpoint d at=660,370 mode=catmull-rom tension=0.16
  addpoint e at=790,328 mode=catmull-rom tension=0.16
  addpoint right at=890,350 mode=catmull-rom tension=0.16
  addpoint br at=890,416
  addpoint bl at=70,416
  close
  fill #091d2b

shape window-bar template=rectangle
  fill $window-frame

shape eyebrow template=text
  content "QUIET HOUR"
  font-size 15
  font-weight bold
  font-family "sans-serif"
  fill $moon

shape title template=text
  content "A small world, held still."
  font-size 37
  font-weight bold
  font-family "Georgia"
  fill $ink

shape caption template=text
  content "Steam, paper, moonlight—and the last page of the day."
  font-size 16
  font-family "sans-serif"
  fill $muted

place background shape=background at=0,0 size=960x720
place window-recess shape=window-recess at=48,38 size=864x392
place sky-glow shape=sky-glow at=616,52 size=258x258
place moon shape=moon at=675,100 size=142x142
place moon-shade shape=moon-shade at=712,111 size=92x120 rotation=-18deg

place star-a shape=star center=266,98 radius=2
place star-b shape=star center=286,216 radius=1.4
place star-c shape=star center=335,88 radius=1.8
place star-d shape=star center=510,146 radius=1.5
place star-e shape=star center=592,82 radius=2.2
place star-f shape=star center=842,126 radius=1.6
place star-g shape=star center=866,215 radius=1.2

place far-hills shape=far-hills at=0,0
place near-hills shape=near-hills at=0,0
place window-sill shape=window-bar at=58,412 size=844x18

place eyebrow shape=eyebrow at=92,102
place title shape=title at=90,151
place caption shape=caption at=92,184

# --- Desk and grounding -----------------------------------------------------

shape desk-surface template=rectangle
  fill linear(top, bottom, #603c2d, #3a251f)

shape desk-lip template=rectangle
  fill $desk-edge

shape wood-grain template=path
  addpoint left at=0,0
  addpoint a at=80,-5 mode=catmull-rom tension=0.16
  addpoint b at=170,4 mode=catmull-rom tension=0.16
  addpoint right at=260,0 mode=catmull-rom tension=0.16
  stroke #9a6246
  stroke-width 2
  stroke-linecap round
  fill none
  opacity 0.22

place desk-surface shape=desk-surface at=0,430 size=960x290
place desk-lip shape=desk-lip at=0,430 size=960x8
place grain-a shape=wood-grain at=36,672
place grain-b shape=wood-grain at=358,694 flip=x
place grain-c shape=wood-grain at=680,650

# --- Open book --------------------------------------------------------------

shape book-shadow template=ellipse
  fill #120d0b
  opacity 0.38
  blur 12

shape left-page-edge template=path
  addpoint spine-top at=468,495
  addpoint outer-top at=205,478 mode=controls c1=390,486 c2=282,466
  addpoint outer-bottom at=158,650 mode=controls c1=178,522 c2=152,605
  addpoint spine-bottom at=471,634 mode=controls c1=250,652 c2=390,622
  close
  fill #a88d69

shape right-page-edge template=path
  addpoint spine-top at=468,495
  addpoint outer-top at=712,482 mode=controls c1=545,484 c2=634,469
  addpoint outer-bottom at=765,645 mode=controls c1=738,520 c2=762,598
  addpoint spine-bottom at=471,634 mode=controls c1=650,648 c2=548,624
  close
  fill #a88d69

shape left-page template=path
  addpoint spine-top at=468,486
  addpoint outer-top at=207,469 mode=controls c1=390,477 c2=285,457
  addpoint outer-bottom at=164,636 mode=controls c1=180,512 c2=158,594
  addpoint spine-bottom at=471,624 mode=controls c1=252,638 c2=390,612
  addpoint spine-close at=468,486 mode=controls c1=476,580 c2=475,520
  close
  fill linear(top, bottom, #f7ecd7, #ddd0b4)
  stroke $paper-edge
  stroke-width 1.2

shape right-page template=path
  addpoint spine-top at=468,486
  addpoint outer-top at=710,473 mode=controls c1=548,474 c2=634,460
  addpoint outer-bottom at=758,633 mode=controls c1=734,514 c2=755,590
  addpoint spine-bottom at=471,624 mode=controls c1=650,637 c2=550,612
  addpoint spine-close at=468,486 mode=controls c1=463,578 c2=462,522
  close
  fill linear(top, bottom, #f7ecd7, #e3d2b5)
  stroke $paper-edge
  stroke-width 1.2

shape page-seam-shadow template=path
  addpoint top at=468,487
  addpoint middle at=461,556 mode=controls c1=474,516 c2=461,532
  addpoint bottom at=471,625 mode=controls c1=461,581 c2=468,607
  stroke #8f7656
  stroke-width 7
  stroke-linecap round
  fill none
  opacity 0.24
  blur 3

shape page-seam template=path
  addpoint top at=468,487
  addpoint middle at=466,554 mode=controls c1=472,516 c2=465,534
  addpoint bottom at=471,625 mode=controls c1=465,580 c2=468,607
  stroke #bba27f
  stroke-width 2
  stroke-linecap round
  fill none

shape right-type-line template=path
  addpoint inner at=0,0
  addpoint outer at=150,-3 mode=controls c1=48,-1 c2=104,-5
  stroke $type
  stroke-width 2
  stroke-linecap round
  fill none
  opacity 0.52

shape chapter-mark template=ellipse
  fill $moon-edge
  opacity 0.76

shape bookmark template=path
  addpoint top-left at=497,492
  addpoint top-right at=514,493
  addpoint bottom-right at=515,650
  addpoint notch at=506,641
  addpoint bottom-left at=497,650
  close
  fill #b65f4c
  opacity 0.9

place book-shadow shape=book-shadow at=130,588 size=670x84
place left-page-edge shape=left-page-edge at=0,0
place right-page-edge shape=right-page-edge at=0,0
place bookmark shape=bookmark at=0,0
place left-page shape=left-page at=0,0
place right-page shape=right-page at=0,0
place page-seam-shadow shape=page-seam-shadow at=0,0
place page-seam shape=page-seam at=0,0

place chapter-dot-left shape=chapter-mark center=278,508 radius=4
place chapter-dot-right shape=chapter-mark center=647,510 radius=4

place left-line-1 shape=right-type-line at=248,526 size=178x8
place left-line-2 shape=right-type-line at=262,546 size=159x8
place left-line-3 shape=right-type-line at=232,566 size=184x8
place left-line-4 shape=right-type-line at=270,586 size=140x8
place left-line-5 shape=right-type-line at=239,606 size=166x8

place right-line-1 shape=right-type-line at=508,526 size=172x8
place right-line-2 shape=right-type-line at=511,546 size=148x8
place right-line-3 shape=right-type-line at=515,566 size=180x8
place right-line-4 shape=right-type-line at=519,586 size=132x8
place right-line-5 shape=right-type-line at=523,606 size=158x8

# Reading glasses rest partly on the left page.
shape lens template=ellipse
  fill none
  stroke #425b68
  stroke-width 3.5

shape lens-tint template=ellipse
  fill #9eb4bd
  opacity 0.12

shape glasses-bridge template=path
  addpoint left at=346,559
  addpoint middle at=357,552 mode=controls c1=350,554 c2=353,552
  addpoint right at=369,559 mode=controls c1=361,552 c2=365,554
  stroke #425b68
  stroke-width 3.5
  stroke-linecap round
  fill none

shape glasses-hinge-left template=path
  addpoint hinge at=283,558
  addpoint bend at=261,550 mode=controls c1=276,556 c2=268,553
  addpoint tip at=244,537 mode=controls c1=254,547 c2=248,542
  stroke #425b68
  stroke-width 3.5
  stroke-linecap round
  fill none

shape glasses-hinge-right template=path
  addpoint hinge at=432,558
  addpoint bend at=453,550 mode=controls c1=439,556 c2=446,553
  addpoint tip at=470,537 mode=controls c1=460,547 c2=466,542
  stroke #425b68
  stroke-width 3.5
  stroke-linecap round
  fill none

place lens-tint-left shape=lens-tint at=282,537 size=66x44 rotation=-3deg
place lens-tint-right shape=lens-tint at=367,537 size=66x44 rotation=3deg
place lens-left shape=lens at=282,537 size=66x44 rotation=-3deg
place lens-right shape=lens at=367,537 size=66x44 rotation=3deg
place glasses-bridge shape=glasses-bridge at=0,0
place glasses-hinge-left shape=glasses-hinge-left at=0,0
place glasses-hinge-right shape=glasses-hinge-right at=0,0

# --- Tea service ------------------------------------------------------------

shape cup-cast-shadow template=ellipse
  fill #100c0a
  opacity 0.42
  blur 10

shape saucer template=ellipse
  fill linear(top, bottom, #f6efe4, #c7baa9)
  stroke #fffaf2
  stroke-width 2

shape saucer-well template=ellipse
  fill #c9bcaa
  opacity 0.72

shape handle-shadow template=path
  addpoint top at=750,496
  addpoint outer-top at=826,505 mode=controls c1=782,488 c2=816,491
  addpoint outer-bottom at=824,574 mode=controls c1=843,527 c2=842,561
  addpoint bottom at=744,598 mode=controls c1=802,594 c2=775,608
  stroke #10151a
  stroke-width 28
  stroke-linecap round
  fill none
  opacity 0.36

shape handle template=path
  addpoint top at=750,496
  addpoint outer-top at=822,506 mode=controls c1=781,492 c2=812,495
  addpoint outer-bottom at=820,570 mode=controls c1=837,529 c2=836,558
  addpoint bottom at=744,594 mode=controls c1=799,590 c2=774,602
  stroke $ceramic
  stroke-width 18
  stroke-linecap round
  fill none

shape handle-highlight template=path
  addpoint top at=760,502
  addpoint outer at=816,515 mode=controls c1=783,500 c2=806,502
  stroke #fffdf7
  stroke-width 4
  stroke-linecap round
  fill none
  opacity 0.72

shape cup-body template=path
  addpoint top-left at=620,487 mode=controls c1=623,575 c2=618,520
  addpoint top-right at=756,487
  addpoint lower-right at=742,595 mode=controls c1=756,530 c2=753,576
  addpoint base-right at=729,617 mode=controls c1=740,608 c2=736,616
  addpoint base-left at=647,617 mode=controls c1=708,623 c2=668,623
  addpoint lower-left at=634,595 mode=controls c1=640,615 c2=636,606
  close
  fill linear(top, bottom, #f6efe4, #cfc2b0)
  stroke #fffaf2
  stroke-width 1.5
  stroke-linejoin round

shape cup-body-shade template=path
  addpoint top at=724,494
  addpoint right at=741,533 mode=controls c1=735,505 c2=742,518
  addpoint bottom at=714,608 mode=controls c1=742,568 c2=732,598
  addpoint left at=691,612 mode=controls c1=708,611 c2=699,612
  addpoint top-close at=724,494 mode=controls c1=710,579 c2=716,527
  close
  fill #b9aa97
  opacity 0.22

shape cup-rim template=ellipse
  fill $ceramic
  stroke #fffdf8
  stroke-width 2

shape tea-liquid template=ellipse
  fill radial(center, 76%, #d58445, #a95829)

shape tea-glint template=path
  addpoint left at=645,489
  addpoint middle at=677,485 mode=controls c1=654,486 c2=667,485
  addpoint right at=706,488 mode=controls c1=687,485 c2=699,486
  stroke #f6bd79
  stroke-width 3
  stroke-linecap round
  fill none
  opacity 0.74

shape front-rim-highlight template=path
  addpoint left at=620,488
  addpoint middle at=688,503 mode=controls c1=644,499 c2=666,503
  addpoint right at=756,488 mode=controls c1=710,503 c2=734,499
  stroke #fffdf8
  stroke-width 3
  stroke-linecap round
  fill none

shape cup-highlight template=path
  addpoint top at=643,515
  addpoint middle at=638,554 mode=controls c1=639,527 c2=637,542
  addpoint bottom at=650,583 mode=controls c1=638,567 c2=642,578
  stroke #fffdf8
  stroke-width 7
  stroke-linecap round
  fill none
  opacity 0.54

shape base-highlight template=path
  addpoint left at=655,622
  addpoint right at=711,622 mode=controls c1=674,625 c2=693,625
  stroke #fffaf2
  stroke-width 3
  stroke-linecap round
  fill none
  opacity 0.72

shape steam template=path
  addpoint bottom at=0,76
  addpoint low at=-7,53 mode=controls c1=-5,68 c2=-10,61
  addpoint middle at=6,32 mode=controls c1=-3,45 c2=7,42
  addpoint top at=0,0 mode=controls c1=4,20 c2=-4,12
  stroke $muted
  stroke-width 4
  stroke-linecap round
  fill none
  opacity 0.46

place cup-shadow shape=cup-cast-shadow at=584,601 size=285x68
place saucer shape=saucer at=585,598 size=270x62
place saucer-well shape=saucer-well at=631,608 size=178x30
place handle-shadow shape=handle-shadow at=0,0
place handle shape=handle at=0,0
place handle-highlight shape=handle-highlight at=0,0
place cup-body shape=cup-body at=0,0
place cup-body-shade shape=cup-body-shade at=0,0
place cup-rim shape=cup-rim at=612,474 size=152x34
place tea shape=tea-liquid at=621,480 size=134x22
place tea-glint shape=tea-glint at=0,0
place front-rim-highlight shape=front-rim-highlight at=0,0
place cup-highlight shape=cup-highlight at=0,0
place base-highlight shape=base-highlight at=0,0
place steam-left shape=steam at=653,374
place steam-middle shape=steam at=691,356 flip=x
place steam-right shape=steam at=725,386

# A teaspoon, deliberately constructed as a recognizable utensil.
shape spoon-shadow template=path
  addpoint bowl at=855,614
  addpoint handle at=900,544 mode=controls c1=873,593 c2=891,561
  stroke #140f0d
  stroke-width 12
  stroke-linecap round
  fill none
  opacity 0.34
  blur 4

shape spoon-handle template=path
  addpoint bowl at=852,608
  addpoint middle at=875,575 mode=controls c1=859,598 c2=867,587
  addpoint end at=900,536 mode=controls c1=883,562 c2=893,546
  stroke $metal
  stroke-width 7
  stroke-linecap round
  fill none

shape spoon-bowl template=ellipse
  fill linear(left, right, #6d818e, #d8e1e5)
  stroke #dce6ea
  stroke-width 2

shape spoon-glint template=path
  addpoint left at=838,603
  addpoint right at=861,596 mode=controls c1=846,601 c2=854,598
  stroke #f2f7f8
  stroke-width 2
  stroke-linecap round
  fill none
  opacity 0.72

place spoon-shadow shape=spoon-shadow at=0,0
place spoon-handle shape=spoon-handle at=0,0
place spoon-bowl shape=spoon-bowl at=827,592 size=44x28 rotation=-18deg
place spoon-glint shape=spoon-glint at=0,0
