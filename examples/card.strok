# A compact product card: hierarchy, data visualization, and a clear action.
# Render: strok -f examples/card.strok render --out examples/card.png
documentsize 640x420

palette
  canvas-a #07111f
  canvas-b #111a31
  surface #111d33
  surface-edge #2b3a58
  accent-a #48d6c7
  accent-b #5b7cff
  ink #f6f8ff
  muted #91a0bb
  grid #25324b

shape canvas template=rectangle
  fill linear(top, bottom, #07111f, #111a31)

shape ambient template=ellipse
  fill radial(center, 80%, #3559d6, transparent)
  opacity 0.3
  blur 18

shape panel template=rectangle
  round-corners 26
  fill $surface
  stroke $surface-edge
  stroke-width 1

shape badge template=rectangle
  round-corners 10
  fill #1e3048

shape button template=rectangle
  round-corners 12
  fill linear(left, right, #48d6c7, #5b7cff)

shape gridline template=line
  stroke $grid
  stroke-width 1

shape chart template=path
  addpoint a at=0,72
  addpoint b at=62,58 mode=catmull-rom tension=0.2
  addpoint c at=126,66 mode=catmull-rom tension=0.2
  addpoint d at=194,32 mode=catmull-rom tension=0.2
  addpoint e at=268,40 mode=catmull-rom tension=0.2
  addpoint f at=342,4 mode=catmull-rom tension=0.2
  stroke $accent-a
  stroke-width 4
  stroke-linecap round
  fill none

shape point template=ellipse
  fill $accent-a
  stroke $surface
  stroke-width 3

shape eyebrow template=text
  content "WEEKLY SIGNAL"
  font-size 12
  font-weight bold
  font-family "sans-serif"
  fill $accent-a

shape title template=text
  content "Build momentum"
  font-size 34
  font-weight bold
  font-family "sans-serif"
  fill $ink

shape subtitle template=text
  content "A calm view of meaningful progress."
  font-size 16
  font-family "sans-serif"
  fill $muted

shape metric template=text
  content "+24%"
  font-size 24
  font-weight bold
  font-family "sans-serif"
  fill $ink

shape metric-label template=text
  content "this week"
  font-size 13
  font-family "sans-serif"
  fill $muted

shape button-label template=text
  content "Open report"
  font-size 15
  font-weight bold
  font-family "sans-serif"
  fill #08111f
  text-anchor middle

place canvas shape=canvas at=0,0 size=640x420
place ambient shape=ambient at=300,-40 size=380x300
place card shape=panel at=60,42 size=520x336

place badge shape=badge at=96,78 size=120x28
place eyebrow shape=eyebrow at=111,97
place title shape=title at=96,148
place subtitle shape=subtitle at=96,177

place grid-a shape=gridline from=96,232 to=438,232
place grid-b shape=gridline from=96,268 to=438,268
place grid-c shape=gridline from=96,304 to=438,304
place chart shape=chart at=96,218
place latest shape=point at=432,216 size=12x12

place metric shape=metric at=474,249
place metric-label shape=metric-label at=474,273
place action shape=button at=454,306 size=92x40
place action-label shape=button-label at=500,331
