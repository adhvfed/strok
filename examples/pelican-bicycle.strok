documentsize 600x500

# Background
shape bg template=rectangle
  fill #e8d4c0

place bg shape=bg at=0,0 size=600x500

# Ground
shape ground template=line
  stroke #c9a87a
  stroke-width 3

place ground shape=ground from=0,420 to=600,420

# Clouds
shape cloud template=ellipse
  fill #f5e8dc
  stroke #e0cbb8
  stroke-width 1

place cloud1 shape=cloud at=50,40 size=70x40
place cloud2 shape=cloud at=450,70 size=90x40

# ---- BICYCLE FRAME & STRUCTURE ----

# Back wheel - large circle
shape wheel-big template=ellipse
  fill none
  stroke #8b6f47
  stroke-width 5

place wheel-back shape=wheel-big at=50,300 size=150x150

# Front wheel
place wheel-front shape=wheel-big at=390,300 size=150x150

# Wheel hubs/centers
shape hub template=ellipse
  fill #a68968
  stroke #6b5344
  stroke-width 1

place hub-b shape=hub at=122,372 size=16x16
place hub-f shape=hub at=462,372 size=16x16

# Wheel spokes
shape spoke-rim template=ellipse
  fill none
  stroke #a68968
  stroke-width 1

place spoke-b shape=spoke-rim at=85,335 size=80x80
place spoke-f shape=spoke-rim at=425,335 size=80x80

# Frame tubes - main triangle
shape tube-vert template=path
  addpoint p1 at=0,0
  addpoint p2 at=0,50
  stroke #6b5344
  stroke-width 3.5
  stroke-linecap round

place seat-tube shape=tube-vert at=255,250

shape top-tube template=path
  addpoint p1 at=0,0
  addpoint p2 at=120,-15 mode=catmull-rom
  stroke #6b5344
  stroke-width 3.5
  stroke-linecap round

place top-tube shape=top-tube at=255,250

shape down-tube template=path
  addpoint p1 at=0,0
  addpoint p2 at=125,35 mode=catmull-rom
  stroke #6b5344
  stroke-width 3.5
  stroke-linecap round

place down-tube shape=down-tube at=255,250

# Seat stays - rear frame
shape stay template=path
  addpoint p1 at=0,0
  addpoint p2 at=75,65 mode=catmull-rom
  stroke #6b5344
  stroke-width 2.5
  stroke-linecap round

place seat-stay-l shape=stay at=255,300
place seat-stay-r shape=stay at=330,300

# Chainring (large)
shape chainring template=ellipse
  fill none
  stroke #8b6f47
  stroke-width 2.5

place chainring shape=chainring at=295,315 size=45x45

# Crank arm
shape crank-arm template=path
  addpoint p1 at=0,0
  addpoint p2 at=35,-30 mode=catmull-rom
  stroke #6b5344
  stroke-width 2.5
  stroke-linecap round

place crank shape=crank-arm at=318,338

# Pedal platform
shape pedal template=rectangle
  fill #a68968
  stroke #6b5344
  stroke-width 1.5

place pedal shape=pedal at=330,295 size=24x12

# Seat
shape seat template=ellipse
  fill #8b6f47
  stroke #6b5344
  stroke-width 2

place seat shape=seat at=230,230 size=50x15

# Handlebars
shape bars template=ellipse
  fill none
  stroke #6b5344
  stroke-width 2.5

place handlebars shape=bars at=370,220 size=70x28

# Head tube
shape head-tube template=path
  addpoint p1 at=0,0
  addpoint p2 at=0,-40
  stroke #6b5344
  stroke-width 2.5
  stroke-linecap round

place head-tube shape=head-tube at=380,265

# Fork
shape fork template=path
  addpoint p1 at=0,0
  addpoint p2 at=30,85 mode=catmull-rom
  stroke #6b5344
  stroke-width 2.5
  stroke-linecap round

place fork-left shape=fork at=370,260
place fork-right shape=fork at=390,260

# Chain line
shape chain template=path
  addpoint start at=0,0
  addpoint mid at=40,20 mode=catmull-rom
  addpoint end at=75,45
  stroke #8b6f47
  stroke-width 1.5

place chain shape=chain at=318,338

# ---- PELICAN ----

# Body - main torso
shape body template=ellipse
  fill #d4a574
  stroke #c8963a
  stroke-width 1.5

place body shape=body at=245,280 size=70x80

# Head
shape head template=ellipse
  fill #d4a574
  stroke #c8963a
  stroke-width 1.5

place head shape=head at=305,225 size=42x50

# Neck - curved connection
shape neck template=path
  addpoint bottom at=0,0
  addpoint mid at=12,-15 mode=catmull-rom tension=0.2
  addpoint top at=25,-40
  stroke #d4a574
  stroke-width 14
  stroke-linecap round

place neck shape=neck at=268,310

# Long distinctive beak
shape beak template=path
  addpoint base at=0,0
  addpoint mid at=25,-3 mode=catmull-rom
  addpoint tip at=65,0
  stroke #c8963a
  stroke-width 6
  stroke-linecap round

place beak shape=beak at=345,220

# Beak pouch (subtle curved shape below)
shape pouch template=path
  addpoint l at=0,0
  addpoint m at=30,5 mode=catmull-rom
  addpoint r at=60,2
  close
  fill #c8963a
  stroke none

place pouch shape=pouch at=348,228

# Eye
shape eye template=ellipse
  fill #2a1810
  stroke #1a0f08
  stroke-width 0.5

place eye shape=eye at=316,215 size=7x7

# Eye highlight
shape pupil template=ellipse
  fill #ffffff
  stroke none

place pupil shape=pupil at=321,212 size=2.5x2.5

# Wing - folded against body
shape wing template=path
  addpoint top at=0,0
  addpoint left at=-35,-15 mode=catmull-rom
  addpoint bottom at=-40,40 mode=catmull-rom
  close
  fill #d4a574
  stroke #c8963a
  stroke-width 1.5

place wing shape=wing at=245,290

# Feet gripping seat
shape foot template=ellipse
  fill #c8963a
  stroke #8b6f47
  stroke-width 0.5

place foot-l shape=foot at=235,305 size=11x13
place foot-r shape=foot at=285,305 size=11x13

# Tail feathers (back)
shape tail template=path
  addpoint tip at=0,-25
  addpoint left at=-18,5 mode=catmull-rom
  addpoint right at=18,5 mode=catmull-rom
  close
  fill #c8963a
  stroke #8b6f47
  stroke-width 1

place tail shape=tail at=230,370
