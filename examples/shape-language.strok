# A visual tour of Strøk's core shape vocabulary.
# Render: strok -f examples/shape-language.strok render --out examples/shape-language.png
documentsize 820x460

palette
  canvas #f4f0e8
  card #fffdf8
  border #ddd5c8
  ink #242738
  muted #77798a
  coral #ef6a5b
  blue #546ff1
  mint #43b896
  gold #e8a43a
  violet #9a67df

shape canvas template=rectangle
  fill $canvas

shape card template=rectangle
  round-corners 18
  fill $card
  stroke $border
  stroke-width 1

shape title template=text
  content "Shape language"
  font-size 28
  font-weight bold
  font-family "sans-serif"
  fill $ink

shape subtitle template=text
  content "Six small ideas, all editable as plain text."
  font-size 14
  font-family "sans-serif"
  fill $muted

shape label-corners template=text
  content "CORNERS"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $muted

shape label-arcs template=text
  content "ARCS"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $muted

shape label-curves template=text
  content "CURVES"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $muted

shape label-notches template=text
  content "NOTCHES"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $muted

shape label-transform template=text
  content "TRANSFORMS"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $muted

shape label-paint template=text
  content "PAINT"
  font-size 11
  font-weight bold
  font-family "sans-serif"
  fill $muted

shape rounded template=rectangle
  round-corners tl=28 tr=8 br=28 bl=8
  fill $coral

shape arc template=path
  addpoint left at=0,55
  addpoint right at=110,55 mode=arc rx=55 ry=55 bulge=left
  stroke $blue
  stroke-width 8
  stroke-linecap round
  fill none

shape wave template=path
  addpoint a at=0,36
  addpoint b at=35,8 mode=catmull-rom tension=0.1
  addpoint c at=72,54 mode=catmull-rom tension=0.1
  addpoint d at=110,20 mode=catmull-rom tension=0.1
  stroke $mint
  stroke-width 7
  stroke-linecap round
  fill none

shape folder template=rectangle
  notch edge=top dir=out shape=square pos=0.28 width=34 depth=16
  round-corners 10
  fill $gold

shape diamond template=rectangle
  round-corners 5
  fill $violet

shape paint template=ellipse
  fill linear(left, right, #546ff1, #b56ce1, #ef6a5b)

shape shine template=ellipse
  fill radial(center, 80%, #ffffff, transparent)
  opacity 0.5

place background shape=canvas at=0,0 size=820x460
place title shape=title at=40,50
place subtitle shape=subtitle at=40,75

place card-a shape=card at=40,104 size=230x148
place card-b shape=card at=295,104 size=230x148
place card-c shape=card at=550,104 size=230x148
place card-d shape=card at=40,276 size=230x148
place card-e shape=card at=295,276 size=230x148
place card-f shape=card at=550,276 size=230x148

place label-a shape=label-corners at=60,132
place demo-a shape=rounded at=94,156 size=124x64

place label-b shape=label-arcs at=315,132
place demo-b shape=arc at=354,158 size=112x62

place label-c shape=label-curves at=570,132
place demo-c shape=wave at=610,158 size=112x62

place label-d shape=label-notches at=60,304
place demo-d shape=folder at=94,344 size=124x58

place label-e shape=label-transform at=315,304
place diamond-a shape=diamond at=340,350 size=48x48 rotation=-18deg
place diamond-b shape=diamond at=390,338 size=58x58 rotation=18deg
place diamond-c shape=diamond at=450,356 size=40x40 rotation=42deg

place label-f shape=label-paint at=570,304
place paint shape=paint at=606,334 size=126x72
place shine shape=shine at=626,342 size=60x30
